    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/api/v1/automation/transactions/{{$json.transaction_public_id}}/schedule",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({sharepoint:$json.sharepoint,hubspot:$json.hubspot,outlook_draft:$json.outlook_draft,teams_notify:$json.teams_notify,verified_contact_email:$json.verified_contact_email||null,confirm_external_data_transfer:$json.confirm_external_data_transfer}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d07ca5bd-9af9-49c6-a9d4-5bfce6fda003",
      "name": "Ask OrderNexa to schedule verified writes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json; return [{json:{public_id:d.public_id,jobs:d.jobs,live_writes_enabled:d.live_writes_enabled,note:'n8n only scheduled durable jobs; FastAPI/worker remain authoritative.'}}];"
      },
      "id": "d07ca5bd-9af9-49c6-a9d4-5bfce6fda004",

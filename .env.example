# OrderNexa AI — safe configuration template
# Copy to .env locally. Never commit the real .env.

APP_NAME=OrderNexa AI
APP_ENV=development
APP_DEBUG=false
APP_SECRET=CHANGE_ME_48_PLUS_RANDOM_CHARS
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api
SECURITY_MAX_REQUEST_BYTES=20971520
RATE_LIMIT_REQUESTS_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_REQUESTS_PER_MINUTE=300

POSTGRES_DB=ordernexa
POSTGRES_USER=ordernexa
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://ordernexa:CHANGE_ME@postgres:5432/ordernexa

REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

MINIO_ROOT_USER=ordernexa
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ordernexa-artifacts
MAX_UPLOAD_BYTES=15728640

ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME
ODOO_DB_NAME=postgres
ODOO_BASE_URL=http://odoo:8069
ORDERNEXA_ODOO_SHARED_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME_48_PLUS_RANDOM_CHARS
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_INGEST_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TEXT_MODEL=qwen2.5:0.5b
OLLAMA_VISION_MODEL=
OLLAMA_PROBE_MODEL=qwen2.5:0.5b
OLLAMA_READ_TIMEOUT_SECONDS=75
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_INPUT_CHARS=12000
OLLAMA_PROBE_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Development identity only. Production should use OIDC.
# Keep the legacy single operator key EMPTY when role keys are configured,
# otherwise the same secret can accidentally map to conflicting roles.
AUTH_MODE=auto
ORDERNEXA_OPERATOR_KEY=
ORDERNEXA_OPERATOR_ACTOR=LOCAL_OPERATOR
ORDERNEXA_OPERATOR_ROLE=OPERATIONS_MANAGER
ORDERNEXA_ROLE_KEYS_JSON={}
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_ACTOR_CLAIM=oid
OIDC_ROLE_MAP_JSON={}
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_CLOCK_SKEW_SECONDS=60

# Durable worker / guarded external writes.
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_LIVE_WRITES=false
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_LEASE_SECONDS=900
AUTOMATION_HEARTBEAT_SECONDS=30
AUTOMATION_DB_RETRY_MAX_SECONDS=60
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=120
CUSTOMER_EMAIL_ENABLED=false

# Microsoft Graph / Microsoft 365
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_CLIENT_STATE=
GRAPH_SUBSCRIPTION_ID=
GRAPH_NOTIFICATION_URL=
GRAPH_LIFECYCLE_URL=
GRAPH_SUBSCRIPTION_RESOURCE=
GRAPH_DRIVE_ID=
GRAPH_DELTA_MAX_PAGES=10
GRAPH_RENEWAL_MARGIN_MINUTES=180
GRAPH_MAINTENANCE_INTERVAL_SECONDS=900

# CRM / Teams
HUBSPOT_ACCESS_TOKEN=
TEAMS_APPROVAL_WEBHOOK_URL=

# Voice
VOICE_SERVER_SECRET=

# Stripe test mode only
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/console/?stripe=success
STRIPE_CANCEL_URL=http://localhost:8000/console/?stripe=cancel
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

ASK_OPS_ENABLED=true

# ============================================================
# OrderNexa AI
# Local Development Environment
# NEVER place production credentials in this file.
# Copy/generate .env locally and keep .env ignored by Git.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="OrderNexa AI"
APP_ENV=development
APP_DEBUG=true
APP_SECRET=CHANGE_ME
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------
# ORDERNEXA POSTGRES + PGVECTOR
# ------------------------------------------------------------
POSTGRES_DB=ordernexa
POSTGRES_USER=ordernexa
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://ordernexa:CHANGE_ME@postgres:5432/ordernexa

# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ------------------------------------------------------------
# MINIO
# ------------------------------------------------------------
MINIO_ROOT_USER=ordernexa
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ordernexa-artifacts

# ------------------------------------------------------------
# ODOO
# ------------------------------------------------------------
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME
ODOO_DB_NAME=postgres
ODOO_URL=http://odoo:8069
ODOO_PUBLIC_URL=http://localhost:8069

# ------------------------------------------------------------
# N8N
# ------------------------------------------------------------
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------
# AI PROVIDERS
# Ollama remains the local AI provider; no cloud provider is enabled.
# ------------------------------------------------------------
# To switch to Windows-native Ollama after validating it outside Docker,
# replace OLLAMA_BASE_URL below with http://host.docker.internal:11434.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# HUBSPOT
# ------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=

# ------------------------------------------------------------
# MICROSOFT GRAPH / ENTRA
# ------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ------------------------------------------------------------
# VAPI
# ------------------------------------------------------------
VAPI_API_KEY=

# ------------------------------------------------------------
# TWILIO
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------
# STRIPE SANDBOX
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
OTEL_SERVICE_NAME=ordernexa-api
OTEL_EXPORTER_OTLP_ENDPOINT=

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=granite3.2-vision:2b

MAX_UPLOAD_BYTES=15728640

ODOO_BASE_URL=http://odoo:8069
ORDERNEXA_ODOO_SHARED_SECRET=CHANGE_ME
# OrderNexa local-only safe operation controls. Generate a new random 32-byte token.
ORDERNEXA_OPERATOR_KEY=CHANGE_ME
ORDERNEXA_OPERATOR_ACTOR=LOCAL_OPERATOR
ORDERNEXA_OPERATOR_ROLE=FINANCE_MANAGER

# Ollama runtime and failure timeouts (model loading must be verified separately).
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=75
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_INPUT_CHARS=12000
OLLAMA_PROBE_MODEL=qwen2.5:0.5b
OLLAMA_PROBE_TIMEOUT_SECONDS=180
ORDERNEXA_ROLE_KEYS_JSON=


# ------------------------------------------------------------
# DURABLE INTEGRATION WORKER - DEFAULT OFF
# A profile worker starts ONLY after local DB migration and explicit opt-in.
# ------------------------------------------------------------
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_LIVE_WRITES=false
AUTOMATION_MAX_ATTEMPTS=5
N8N_INGEST_SECRET=
GRAPH_CLIENT_STATE=
GRAPH_SUBSCRIPTION_ID=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_DRIVE_ID=
TEAMS_APPROVAL_WEBHOOK_URL=
VOICE_SERVER_SECRET=
CUSTOMER_EMAIL_ENABLED=false
# When using Windows Ollama, set OLLAMA_BASE_URL=http://host.docker.internal:11434
# Provide installed model names in OLLAMA_TEXT_MODEL and OLLAMA_VISION_MODEL.
